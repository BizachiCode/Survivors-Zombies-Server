{
  "private": true,
  "name": "card-tower-defense-server",
  "version": "0.1.0",
  "description": "Authoritative Colyseus server for the Card Tower Defense Unity template",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "npm run clean && tsc",
    "start:prod": "node build/index.js",
    "clean": "rimraf build",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "mocha -r tsx \"test/**/*_test.ts\" --exit --timeout 15000",
    "test:e2e": "mocha -r tsx \"test/e2e/*.e2e.ts\" --exit --timeout 60000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.cli.ts",
    "db:studio": "drizzle-kit studio",
    "devdb:init": "powershell -ExecutionPolicy Bypass -File tools/devdb.ps1 init",
    "devdb:start": "powershell -ExecutionPolicy Bypass -File tools/devdb.ps1 start",
    "devdb:stop": "powershell -ExecutionPolicy Bypass -File tools/devdb.ps1 stop"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@colyseus/core": "^0.18.21",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/playground": "^0.18.5",
    "@colyseus/schema": "^5.0.42",
    "@colyseus/tools": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.4",
    "argon2": "^0.45.1",
    "colyseus": "^0.18.9",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
