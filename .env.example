# Copy to .env and fill in real values (the first `npm start` in development does it for you with random secrets).
# NODE_ENV=production refuses to boot with missing, default or short secrets.

NODE_ENV=development
PORT=2567

# Auth (use long random strings in production, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access
ACCESS_TTL_MIN=15
PASSWORD_PEPPER=change-me-pepper
REFRESH_PEPPER=change-me-refresh-pepper
# Hashes the device ids that bind guest accounts (the raw id is never stored).
DEVICE_PEPPER=change-me-device-pepper
REFRESH_TTL_DAYS=60

# MySQL 8+ / MariaDB 10.4+ (the database is created automatically on start; the user needs CREATE rights the first time)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ctd_game_db
MYSQL_POOL_SIZE=12
# Apply pending migrations on boot (defaults to true outside production)
DB_AUTO_MIGRATE=true

# Active sessions: redis (default; required with several processes) or memory (single process, sessions lost on restart)
SESSION_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ctd:

# Chat history (global and clan channels, last 50 messages each) kept between restarts and deploys:
#   db     = MySQL/MariaDB table chat_messages (default)
#   redis  = one Redis list per channel (uses the REDIS_* settings above, even with SESSION_STORE=memory)
#   memory = this process only: the history is lost when the server restarts
CHAT_HISTORY_STORE=db

# Economy: balances granted once to every new account (the Unity Offline backend has the same fields in BackendSettings)
START_COINS=0
START_GEMS=0

# Battle content (cards, enemies, encounters, stages) exported from Unity: Tools > Card Tower Defense > Export Server Content
BATTLE_CONTENT_PATH=content/battle-content.json
# Live content (announcements, mail broadcasts): Tools > Card Tower Defense > Export Live Content. Hot-reloaded on change.
NEWS_CONTENT_PATH=content/news.json
MAIL_CONTENT_PATH=content/mail.json

# In-app purchases (products in the ShopAsset). A store without settings is refused.
# Unity's Editor fake store: development only (refused when NODE_ENV=production).
IAP_ALLOW_FAKE_STORE=true
# Test purchases for demo / QA servers (also in production): every real-money product is granted WITHOUT payment and
# the game skips Google Play / the App Store on every platform (WebGL, Android, iOS, Editor) while this is on.
IAP_TEST_MODE=false
# Receipts must name the buyer (the client sets Apple appAccountToken / Google obfuscatedAccountId).
IAP_REQUIRE_ACCOUNT_BINDING=true
# Google Play: package name plus the licensing key (Play Console > Monetization setup) and/or a service account JSON
# with access to the app (checks cancelled / refunded / pending purchases online).
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_LICENSE_KEY=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Refunds: with the service account above the server polls Google's voided purchases API (minutes between polls).
GOOGLE_VOIDED_POLL_MINUTES=15
# App Store: bundle id; sandbox transactions (TestFlight, App Review) are accepted unless APPLE_ALLOW_SANDBOX=false.
APPLE_BUNDLE_ID=
APPLE_ALLOW_SANDBOX=true
# Refunds: in App Store Connect set the App Store Server Notifications V2 URL (production and sandbox) to
# https://<host>/iap/apple/notifications (see docs/PROTOCOL.md, "Purchase refunds").

# Transport / HTTP
WS_MAX_PAYLOAD_BYTES=65536
HTTP_MAX_BODY_BYTES=65536
# CORS: no origin is allowed by default (native clients need none). Comma-separated exact origins for WebGL builds.
CORS_ORIGINS=
# Client address for rate limits: the socket address unless the server sits behind a reverse proxy (see README).
TRUST_PROXY=false
TRUSTED_PROXIES=

# Colyseus monitor (/monitor) and playground (/playground). Never enabled in production.
DEV_TOOLS=true
MAINTENANCE_MODE=false

# Admin panel (/admin, API /admin/api): off while empty. 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Optional comma separated addresses allowed to reach the panel (empty = any). Behind a proxy also set TRUST_PROXY.
ADMIN_ALLOWED_IPS=
